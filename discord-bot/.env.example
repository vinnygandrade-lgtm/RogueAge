# Discord Developer Portal → Applications → Bot → Token
DISCORD_TOKEN=your_bot_token_here

# Application → General Information → Application ID
DISCORD_CLIENT_ID=your_application_id_here

# Optional: guild ID for instant slash-command sync while developing
# Leave empty to register commands globally (can take up to ~1 hour)
DISCORD_GUILD_ID=

# Optional: channel ID for welcome messages
WELCOME_CHANNEL_ID=

# Optional: comma-separated role IDs allowed to use /announce (empty = Manage Messages permission)
STAFF_ROLE_IDS=

# Public game URL shown in /game
GAME_URL=https://rogueage.vercel.app
